# Copy to .env and edit
PORT=4000
DATABASE_PATH=./server.db

# Gmail SMTP (use a Gmail App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=DayPilot <your-email@gmail.com>

# Admin access (never put these values in frontend code)
ADMIN_USERNAMES=Hamsath,Nihal
# Generate with: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');c.scrypt('your-password',s,64,(e,k)=>console.log(s+':'+k.toString('hex')))"
ADMIN_PASSWORD_HASH=

# Supabase permanent accounts. Keep the service role key server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
